<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- M8 founder lab only. Product microphone permission now lives in the main manifest. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application android:networkSecurityConfig="@xml/debug_network_security_config">
        <!--
            Exported only in debug builds so the founder can launch it with adb.
            The activity accepts no secret Intent extras; credentials are entered
            interactively and remain in memory only.
        -->
        <activity
            android:name=".voice.VoiceSpikeActivity"
            android:exported="true"
            android:label="WMW Voice Spike" />
    </application>
</manifest>
