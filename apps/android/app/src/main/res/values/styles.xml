<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WakeMyWay" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#08142F</item>
        <item name="android:colorAccent">#FF9F6D</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#08142F</item>
        <item name="android:navigationBarColor">#08142F</item>
    </style>

    <!-- MainActivity only. WakeActivity intentionally keeps Theme.WakeMyWay so an alarm never
         renders or waits on consumer launch branding before presenting the active wake surface. -->
    <style name="Theme.WakeMyWay.Launch" parent="Theme.WakeMyWay">
        <item name="android:windowBackground">@drawable/wmw_launch_background</item>
    </style>
</resources>
