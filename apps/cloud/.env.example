# AI Gateway authenticates with either this key or Vercel OIDC.
AI_GATEWAY_API_KEY=

# Required only for /api/internal/* diagnostics/spike routes.
# Never embed this value in a production Android APK. The debug founder build may store it only
# after explicit operator entry, encrypted with Android Keystore, for private dogfood.
WMW_INTERNAL_API_KEY=

# Current Gateway STT/TTS/realtime defaults below do not provide provider-level
# Zero Data Retention. Keep this FALSE. Enable only for synthetic, non-sensitive
# engineering spikes; never use it for real wake audio, Tomorrow Contract text,
# calendar content, transcripts, or other private user data.
WMW_ENABLE_NON_ZDR_AUDIO_SPIKES=false

# Text model policy. All private text/embedding calls enforce request-level ZDR.
# All values are AI Gateway creator/model slugs.
WMW_AI_FAST_MODEL=openai/gpt-5.4-mini
WMW_AI_FAST_FALLBACKS=anthropic/claude-haiku-4.5,google/gemini-3.5-flash
WMW_AI_SMART_MODEL=anthropic/claude-sonnet-4.6
WMW_AI_SMART_FALLBACKS=openai/gpt-5.4,google/gemini-3.5-flash

# Other modalities through AI Gateway.
WMW_AI_EMBEDDING_MODEL=openai/text-embedding-3-small
WMW_AI_TRANSCRIPTION_MODEL=openai/whisper-1
WMW_AI_SPEECH_MODEL=openai/tts-1
WMW_AI_SPEECH_VOICE=alloy
WMW_AI_REALTIME_MODEL=openai/gpt-realtime-2.1

# M8 direct-OpenAI WebRTC spike. This is deliberately separate from AI Gateway.
# OPENAI_API_KEY stays server-side and is used only to mint short-lived client
# secrets. Do not place it in Android builds.
OPENAI_API_KEY=
WMW_ENABLE_DIRECT_OPENAI_REALTIME_SPIKE=false
WMW_OPENAI_REALTIME_MODEL=gpt-realtime-2.1
WMW_OPENAI_REALTIME_VOICE=marin

# Explicit founder-only real-audio dogfood gate. This does not mean the OpenAI project has ZDR.
# When enabled, the debug founder app may use live wake speech after an explicit in-app consent.
# Never send Tomorrow Contract, calendar, health, identity, or other prepared private context in
# this phase. Production authentication/privacy posture must replace this internal route later.
WMW_ENABLE_FOUNDER_REALTIME_DOGFOOD=false

# OpenAI recommends binding ephemeral Realtime tokens to a stable pseudonymous
# safety identifier. Use a one-way hash/pseudonymous engineering identity, never
# an email address, name, or other raw personal identifier.
WMW_OPENAI_SAFETY_IDENTIFIER=

# The synthetic spike remains synthetic-only. Founder dogfood is a separately gated, explicit
# exception for the founder device and remains non-authoritative to the Alarm Kernel/Wake Runtime.
