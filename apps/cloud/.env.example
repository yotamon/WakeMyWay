# AI Gateway authenticates with either this key or Vercel OIDC.
AI_GATEWAY_API_KEY=

# Required only for /api/internal/* diagnostics/spike routes.
# Never embed this value in the Android app. Use at least 32 random characters.
WMW_INTERNAL_API_KEY=

# Current Gateway STT/TTS/realtime defaults below do not provide provider-level
# Zero Data Retention. Keep this FALSE. Enable only for synthetic, non-sensitive
# engineering spikes; never use it for real wake audio, Tomorrow Contract text,
# calendar content, transcripts, or other private user data.
WMW_ENABLE_NON_ZDR_AUDIO_SPIKES=false

# Text model policy. All private text/embedding calls enforce request-level ZDR.
# All values are AI Gateway creator/model slugs.
WMW_AI_FAST_MODEL=openai/gpt-5.4-mini
WMW_AI_FAST_FALLBACKS=anthropic/claude-haiku-4.5,google/gemini-3.5-flash
WMW_AI_SMART_MODEL=anthropic/claude-sonnet-4.6
WMW_AI_SMART_FALLBACKS=openai/gpt-5.4,google/gemini-3.5-flash

# Other modalities.
WMW_AI_EMBEDDING_MODEL=openai/text-embedding-3-small
WMW_AI_TRANSCRIPTION_MODEL=openai/whisper-1
WMW_AI_SPEECH_MODEL=openai/tts-1
WMW_AI_SPEECH_VOICE=alloy
WMW_AI_REALTIME_MODEL=openai/gpt-realtime-2.1
