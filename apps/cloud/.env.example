# AI Gateway authenticates with either this key or Vercel OIDC.
AI_GATEWAY_API_KEY=

# Optional WakeMyWay account backend. These stay server-side in Vercel.
# NEON_AUTH_BASE_URL is the public Managed Better Auth base URL used for JWKS token verification.
# DATABASE_URL points to the server-only Neon PostgreSQL connection used by Kysely. The Android app
# never receives DATABASE_URL and never queries account backup tables directly.
NEON_AUTH_BASE_URL=
# Server-only HMAC/encryption secret used by the official Neon Auth proxy toolkit.
# Generate at least 32 random characters. Never expose this to Android or source control.
NEON_AUTH_COOKIE_SECRET=
DATABASE_URL=

# Server-only internal API authorization key. Keep at least 32 random characters.
# It is never embedded in Android and is deliberately separate from founder device-token signing.
WMW_INTERNAL_API_KEY=

# Dedicated HMAC key for account-authorized Realtime device credentials. Keep at least 32 random
# characters and separate from WMW_INTERNAL_API_KEY. Rotating it revokes provisioned Realtime
# device credentials without affecting account sessions. During migration the legacy founder key is
# accepted server-side as a fallback, but Android never receives either signing key.
WMW_REALTIME_TOKEN_SIGNING_KEY=

# Legacy debug/founder signing key. Retained only for debug spike compatibility during migration.
WMW_FOUNDER_TOKEN_SIGNING_KEY=

# Current Gateway STT/TTS/realtime defaults below do not provide provider-level
# Zero Data Retention. Keep this FALSE. Enable only for synthetic, non-sensitive
# engineering spikes; never use it for real wake audio, Tomorrow Contract text,
# calendar content, transcripts, or other private user data.
WMW_ENABLE_NON_ZDR_AUDIO_SPIKES=false

# Text model policy. All private text/embedding calls enforce request-level ZDR.
# All values are AI Gateway creator/model slugs.
WMW_AI_FAST_MODEL=openai/gpt-5.4-mini
WMW_AI_FAST_FALLBACKS=anthropic/claude-haiku-4.5,google/gemini-3.5-flash
WMW_AI_SMART_MODEL=anthropic/claude-sonnet-4.6
WMW_AI_SMART_FALLBACKS=openai/gpt-5.4,google/gemini-3.5-flash

# Other modalities through AI Gateway.
WMW_AI_EMBEDDING_MODEL=openai/text-embedding-3-small
WMW_AI_TRANSCRIPTION_MODEL=openai/whisper-1
WMW_AI_SPEECH_MODEL=openai/tts-1
WMW_AI_SPEECH_VOICE=alloy
WMW_AI_REALTIME_MODEL=openai/gpt-realtime-2.1

# Direct OpenAI Realtime. OPENAI_API_KEY stays server-side and is used only to mint short-lived
# Realtime client secrets. Never put a standard OpenAI API key in Android builds.
OPENAI_API_KEY=
WMW_ENABLE_DIRECT_OPENAI_REALTIME_SPIKE=false
WMW_OPENAI_REALTIME_MODEL=gpt-realtime-2.1
WMW_OPENAI_REALTIME_VOICE=marin

# Founder-only real-audio dogfood. The app has a fixed WakeMyWay backend URL and asks only for this
# founder access code during first-time pairing. Use a high-entropy value with at least 24
# characters, keep it out of source control, and rotate it after pairing if desired.
WMW_ENABLE_ACCOUNT_REALTIME=false

# Legacy debug-only founder flow. Consumer Direct builds do not expose or use an access code.
WMW_ENABLE_FOUNDER_REALTIME_DOGFOOD=false
WMW_FOUNDER_PAIRING_CODE=

# OpenAI recommends binding ephemeral Realtime tokens to a stable pseudonymous safety identifier.
# Use a one-way hash/pseudonymous engineering identity, never an email address, name, or other raw
# personal identifier.
WMW_OPENAI_SAFETY_IDENTIFIER=

# Founder pairing issues an expiring installation credential. WakeRuntime, Alarm Kernel, Stop,
# Snooze, and critical audio remain entirely local and do not depend on this cloud configuration.


# Google Play subscription verification. Keep disabled until Play Console/API credentials,
# allowed products and production rate limiting are configured and license-tested.
WMW_PLAY_VERIFICATION_ENABLED=false
WMW_PLAY_PACKAGE_NAME=com.wakemyway.app
WMW_PLAY_SUBSCRIPTION_PRODUCT_IDS=
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=
# The public play-verify route only enables when the operator declares that a production edge
# rate limit exists for it (Vercel WAF/rate-limit rule id). Unauthenticated traffic could
# otherwise exhaust the Google androidpublisher quota.
WMW_PLAY_VERIFY_RATE_LIMIT_RULE_ID=

# Google Play Real-time Developer Notifications (RTDN).
# Keep disabled until the Pub/Sub push subscription uses authenticated OIDC push with the exact
# HTTPS audience and service-account identity below. DATABASE_URL is also required because
# verified subscription lifecycle is persisted as SHA-256 token digests only.
WMW_PLAY_RTDN_ENABLED=false
WMW_PLAY_RTDN_AUDIENCE=
WMW_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=

# Public privacy/support pages. Required before publishing /privacy and /support as launch URLs.
# The routes return 503 until a real monitored address is configured.
WMW_PUBLIC_SUPPORT_EMAIL=

# Android verified App Links. Comma-separate SHA-256 signing-certificate fingerprints when Direct
# and Play use different production certificates. The public /.well-known/assetlinks.json route
# fails closed until at least one valid fingerprint is configured.
WMW_ANDROID_APP_LINK_CERT_SHA256=
